APP_NAME=BiziSmart
APP_ENV=production
## D109 password resets require real mail; never use log/array/failover for tokens.
MAIL_FROM_ADDRESS=support@bizismart.com
MAIL_FROM_NAME=BiziSmart
MAIL_TIMEOUT=10
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
TENANT_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
ADMIN_ALLOWED_IPS=
BIZISMART_HOSTING_PROFILE=shared

# Use the mysql PDO connection against MariaDB; strict mode and InnoDB remain required.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=database
CACHE_LIMITER=database
CACHE_PREFIX=bizismart-production-
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Copy optional storage/messaging/offline signing settings from .env.example privately.
# Selcom/mobile collections and TRA stay unconfigured; never copy local test secrets.
