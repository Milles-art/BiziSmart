APP_NAME=BiziSmart
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:18080
TENANT_DOMAIN=localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=bizismart
DB_USERNAME=bizismart
DB_PASSWORD=
SESSION_DRIVER=array
CACHE_STORE=array
CACHE_LIMITER=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@bizismart.co.tz
MAIL_FROM_NAME=BiziSmart

# Selcom: private operator configuration bound to one business; leave empty until provisioned.
# Use the exact HTTPS API URL supplied by Selcom. Configuration does not enable checkout.
SELCOM_BUSINESS_PUBLIC_ID=
SELCOM_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
SELCOM_WEBHOOK_URL=

# Private product image storage; configure server-side only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Platform administration uses a separate session guard and mandatory TOTP.
ADMIN_DOMAIN=admin.bizismart.co.tz
ADMIN_ALLOWED_IPS=
# Use file/database/Redis (never array) for the deployed admin session.
# SESSION_DRIVER=file; SESSION_LIFETIME=30; SESSION_SECURE_COOKIE=true; SESSION_ENCRYPT=true

# Messaging is privately bound to exactly one shop; no cross-tenant credential fallback.
MESSAGING_BUSINESS_PUBLIC_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Approved utility template with one BODY text parameter. Configure the approved language.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
BEEM_API_KEY=
BEEM_API_SECRET=
BEEM_SENDER_NAME=
